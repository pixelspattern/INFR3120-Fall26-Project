<%- include('partials/header') %>

  <section class="hero">

    <h1>Track every workout in one place.</h1>

    <p>
      Log what you did, how long it took and how it felt,
      then see your recent sessions at a glance.
    </p>

    <a href="/sessions/new" class="hero-button">
      + Log a Session
    </a>

  </section>


  <section class="sessions-section" id="sessions">

    <div class="section-heading">
      <h2>Recent Sessions</h2>
      <p>Your workout activity, all in one place.</p>
    </div>

    <div class="sessions-card">

      <div class="table-responsive">
        <table class="sessions-table">

          <thead>
            <tr>
              <th>Date</th>
              <th>Workout Type</th>
              <th>Duration</th>
              <th>Intensity</th>
              <th>Notes</th>
            </tr>
          </thead>

          <tbody>
            <% if (sessions.length> 0) { %>
              <% sessions.forEach(function(session) { %>
                <tr>
                  <td>
                    <%= session.date.toLocaleDateString() %>
                  </td>
                  <td>
                    <%= session.type %>
                  </td>
                  <td>
                    <%= session.duration %> minutes
                  </td>
                  <td>
                    <%= session.intensity %>
                  </td>
                  <td>
                    <%= session.notes || '-' %>
                  </td>
                </tr>
                <% }); %>
                  <% } %>
          </tbody>

        </table>
      </div>

      <% if (sessions.length===0) { %>
        <div class="empty-state">
          <p>No sessions to show yet.</p>
          <span>Start tracking your progress by logging your first workout!</span>
        </div>
        <% } %>

    </div>

  </section>

  <%- include('partials/footer') %>